{
  "name": "RiskLogin",
  "short_name": "RiskLogin",
  "description": "Risk-based sign-in that asks for more only when a login looks risky.",
  "start_url": "./#account",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f3f5f7",
  "theme_color": "#0b6e66",
  "categories": ["security", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Attack lab", "url": "./#lab", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Security activity", "url": "./#activity", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
